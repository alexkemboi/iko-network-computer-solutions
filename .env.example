# Public build settings for the React site (copy to .env for local overrides).
# Nothing here is secret — Daraja keys go in server/.env only.

# Live M-Pesa Express checkout (STK push) is ON by default — both in
# `npm start` (the API runs inside the dev server) and in production builds.
# Set to false to switch checkout off and only take orders by email.
REACT_APP_MPESA_ENABLED=

# Only needed if the API runs on a DIFFERENT domain from the website,
# e.g. https://api.ikonexsystems.com. Leave empty when nginx serves /api
# on the same domain (recommended).
REACT_APP_API_BASE=

# Optional: send the contact form to another service (Formspree etc.)
REACT_APP_CONTACT_ENDPOINT=
