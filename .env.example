# Copy to .env (project root) and restart `npm start` / rebuild.

# Where the IKONEX API (server/mpesa-server.mjs) is running.
# Leave empty to keep online M-Pesa checkout switched off — orders are then
# sent to info@ikonexsystems.com by email instead, and nothing is charged.
REACT_APP_API_BASE=

# Optional: send the contact form somewhere other than ${REACT_APP_API_BASE}/api/contact
# (e.g. a Formspree/Getform endpoint). Leave empty to use the API above, or the
# visitor's email app when no API is set.
REACT_APP_CONTACT_ENDPOINT=
