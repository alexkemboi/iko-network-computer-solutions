# Copy to server/.env and fill in. Never commit the real file.

PORT=5050
# The website origin allowed to call this API (e.g. https://ikonexsystems.com)
ALLOWED_ORIGIN=http://localhost:3000

# sandbox | production
MPESA_ENV=sandbox

# From https://developer.safaricom.co.ke (your app's keys)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Paybill / shortcode and the Lipa Na M-Pesa Online passkey
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods set this to your Till number (defaults to MPESA_SHORTCODE)
MPESA_PARTY_B=

# Public HTTPS URL Safaricom will call with the payment result
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
